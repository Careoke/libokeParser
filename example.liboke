[gameliboke]
! ^ we start with this 
! this is a comment for liboke
! any thing wirtten here will be ignored by the parser

[settings] \0\
! ^ these are section, unknow section will be ignored
! section starts with \0\ and ends with \1\
! parameter - value
        master_sound - 10.00
        background_sound - 10.00
        background_color - ffffff
! colors as values will be in hex
        default_config - ./am/a/liboke.liboke
! =0= means it's NULL/0 in this case deafult config file is null means the game will use the default address
! as now we don't have any settings pannel so we can just leave it empty
\1\

[cards] \0\
! cards section will hold the values for the libraies, 
! basically we will start the card with (card) then /0I or Init and end with /0K or OK
! as you can guess  means next line then-
!       "Card Name"
!       "Lenght of the music"
!       "Score" =0= means there is no score or the game haven't been played
!       "file path of the music" REQUIRED
!       "file path of the lrc" REQUIRED
!       "file path to the song with lyrics" NOT REQUIRED

        (card) /0I
            I Think I saw your face today
            170
            75
            D:/Musics/My/Dir/I Thought I saw your face today vocals.mp3
            ./lyrics/I Think I saw your face today.lrc
            ./music/I Think I saw your face today vocals.mp3
            /0K
        (card) /0I
            Shapeless you
            170
            92
            D:/Musics/My/Dir/Shape of you vocals.mp3
            ./idk/this/is/example/iguess.lrc
            ./music/shapeless you.mp3
            /0K
        (card) /0I
            As It was
            165.00
            75.00
            D:/Musics/My/Dir/
            D:/Musics/My/Dir/
            D:/Musics/My/Dir/
            /0K
\1\
! finish the config with [DONE]
! after done it won't read anymore lines
[DONE]
